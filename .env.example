# Terminal Velocity - Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# Database Configuration
DB_PASSWORD=your_secure_password_here

# Server Configuration
SSH_PORT=2222
MAX_PLAYERS=100

# Game Configuration
UNIVERSE_SEED=0
NUM_SYSTEMS=100

# PgAdmin (Optional - only used with --profile tools)
PGADMIN_EMAIL=admin@terminal-velocity.local
PGADMIN_PASSWORD=admin_password_here

# Build Configuration (Optional)
VERSION=dev
COMMIT=unknown

# Cloudflare Tunnel (Optional - only used with --profile public or prod compose)
#
# Token for the Cloudflare Tunnel that routes public traffic into the
# server container. Get this from the Cloudflare Zero Trust dashboard →
# Networks → Tunnels → your tunnel → "Install connector" (the long
# eyJ... string inside the docker command they show you).
#
# Rotate any token that has leaked into chat logs, git history, or CI logs.
CLOUDFLARE_TUNNEL_TOKEN=
